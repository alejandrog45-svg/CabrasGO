# CabrasGo backend — dev environment
# El schema (prisma/schema.prisma) usa Postgres real, igual que producción
# (Railway) — no SQLite. Este equipo no tiene Docker, así que para dev local
# usa una Postgres gratis hosteada (Neon.tech o Supabase, ambos tienen tier
# free sin tarjeta) y pega su connection string acá. NUNCA la Postgres de
# producción de Railway — usarías/borrarías datos reales de pasajeros.
NODE_ENV=development
PORT=8080
DATABASE_URL="postgresql://usuario:password@host-de-neon-o-supabase/nombre_db?sslmode=require"

# Pasarelas de pago chilenas (mock / sandbox — no credenciales reales)
TRANSBANK_COMMERCE_CODE="597055555532"
TRANSBANK_API_KEY="sandbox_api_key_cabrasgo"
BANCOESTADO_TEF_API_KEY="sandbox_cuenta_rut_direct"

# Telecomunicaciones y mapas (mock / sandbox)
GOOGLE_MAPS_SERVER_KEY="AIzaSyCabrasGoRapelKey"
CNE_COMBUSTIBLES_API_TOKEN="cne_api_token_las_cabras"

JWT_SECRET="cabrasgo_secret_token_auth_vi_region"

# --- Production reference (Postgres + PostGIS + Redis) ---
