// CabrasGo — Prisma schema (Postgres, used both in dev and in production on
// Railway — see backend/.env.example and README.md for how to point local
// dev at a free Postgres instance, e.g. Neon or Supabase)
//
// This schema is a plain-Postgres adaptation of the authoritative
// Postgres+PostGIS schema from "Fase 1.4 — Manual Técnico y de
// Integración" (section 2), differing in three ways so it runs on any
// Postgres host without the PostGIS extension:
//   1. No PostGIS: GeofenceZone.boundaryPolygon (PostGIS `geometry(Polygon,4326)`)
//      becomes `boundaryPolygonJson`, a JSON string of [ [lat,lng], ... ]
//      vertices. Point-in-polygon containment is computed in TypeScript (see
//      src/lib/geofence.ts) instead of a PostGIS ST_Contains query.
//   2. No enum types: every enum from the reference schema (Role,
//      VehicleCategory, TripStatus, PaymentMethod, PaymentStatus,
//      DriverOperationalStatus) is a `String` column here instead. The
//      allowed literal values are documented next to each field and
//      enforced as TypeScript union types in src/types.ts — application
//      code never writes an out-of-set value. (This was originally a
//      SQLite constraint from an earlier dev setup; kept as-is since it
//      needs no migration to change back.)
//   3. No native string array: Rating.feedbackTags (Postgres `String[]`)
//      becomes `feedbackTagsJson`, a JSON-encoded string decoded in the
//      application layer.
//
// To move to full Postgres+PostGIS, swap the `datasource` block below for:
//
//   datasource db {
//     provider   = "postgresql"
//     url        = env("DATABASE_URL")
//     extensions = [postgis]
//   }
//   generator client {
//     provider        = "prisma-client-js"
//     previewFeatures = ["postgresqlExtensions"]
//   }
//
// ...then restore the six `enum` blocks and the fields that reference them,
// restore `boundaryPolygon Unsupported("geometry(Polygon, 4326)")` on
// GeofenceZone, and change `feedbackTagsJson` back to `feedbackTags String[]`.
// The fare algorithm, REST contracts and trip lifecycle logic are
// provider-agnostic and need no changes.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  rut          String?  @unique
  firstName    String
  lastName     String
  email        String?  @unique
  phone        String
  passwordHash String?
  /// UID de Firebase Auth para login social (Google) / teléfono — null para
  /// cuentas email+password creadas por /auth/register o /auth/register-driver
  firebaseUid  String?  @unique
  /// PASSENGER | DRIVER | ADMIN | DISPATCHER
  role         String   @default("PASSENGER")
  ratingAvg    Decimal  @default(5.00)
  totalTrips   Int      @default(0)
  /// WEBPAY_ONECLICK | CUENTARUT_BANCOESTADO | CASH
  preferredPaymentMethod String   @default("WEBPAY_ONECLICK")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  passengerTrips  Trip[]   @relation("PassengerTrips")
  driverProfile   Driver?
  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")
}

model Driver {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber      String
  licenseExpiry      DateTime
  soapExpiry         DateTime
  technicalReviewExp DateTime
  isKycVerified      Boolean  @default(false)
  /// OFFLINE | AVAILABLE | EN_ROUTE_PICKUP | ON_TRIP | SUSPENDED
  operationalStatus  String   @default("OFFLINE")
  walletBalanceClp   Int      @default(0)
  bankAccountRut     String
  bankCode           String   @default("012")

  vehiclePlate String @unique
  vehicleModel String
  /// STANDARD_SEDAN | RURAL_4X4_XL
  vehicleCategory String @default("STANDARD_SEDAN")
  has4x4          Boolean @default(false)

  currentLatitude  Decimal?
  currentLongitude Decimal?
  lastPingAt       DateTime?
  headingDeg       Decimal?
  speedKmh         Decimal?
  batteryPct       Int?      @default(100)

  // VIP/priority subscription (point 3 of the business model): a VIP driver
  // pays PlatformConfig.vipMonthlyFeeClp and is dispatched first among peers
  // in the same proximity tier (see dispatchTrip in src/routes/passenger.ts).
  isVip   Boolean   @default(false)
  vipSince DateTime?

  trips         Trip[]              @relation("DriverTrips")
  payouts       Payout[]
  weeklyBonuses DriverWeeklyBonus[]
}

model GeofenceZone {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  isHighDemand         Boolean  @default(false)
  dynamicMultiplier    Decimal  @default(1.00)
  require4x4           Boolean  @default(false)
  dirtRoadSurchargeClp Int      @default(0)
  // JSON string of [[lat, lng], ...] polygon vertices (see header note).
  boundaryPolygonJson  String
  createdAt            DateTime @default(now())
}

model FuelBenchmark {
  id             String   @id @default(uuid())
  stationName    String
  stationCode    String
  stationAddress String   @default("")
  comuna         String   @default("Las Cabras")
  gasoline93Clp  Int
  gasoline95Clp  Int?
  dieselClp      Int
  sourceAgency   String   @default("CNE_ENAP")
  reportedAt     DateTime @default(now())
}

model Trip {
  id          String  @id @default(uuid())
  passengerId String
  passenger   User    @relation("PassengerTrips", fields: [passengerId], references: [id])
  driverId    String?
  driver      Driver? @relation("DriverTrips", fields: [driverId], references: [id])

  /// SCHEDULED | REQUESTED | DISPATCHING | ACCEPTED | DRIVER_ARRIVED | IN_PROGRESS | COMPLETED | CANCELLED
  status String @default("REQUESTED")
  /// STANDARD_SEDAN | RURAL_4X4_XL
  category        String @default("STANDARD_SEDAN")
  pinVerification String

  // Set only for trips created via "Programar para más tarde" — a background
  // job (see dispatchDueScheduledTrips in src/routes/passenger.ts) flips
  // status SCHEDULED -> DISPATCHING once scheduledFor is reached.
  scheduledFor DateTime?

  originAddress String
  originLat     Decimal
  originLng     Decimal
  destAddress   String
  destLat       Decimal
  destLng       Decimal

  distanceKmTotal Decimal
  distanceKmPaved Decimal
  distanceKmDirt  Decimal

  geofenceZoneCode  String?
  dynamicMultiplier Decimal @default(1.00)
  fuelFactor        Decimal @default(1.00)

  fareGrossClp   Int
  driverNetClp   Int
  platformFeeClp Int

  /// WEBPAY_ONECLICK | CUENTARUT_BANCOESTADO | CASH
  paymentMethod String @default("WEBPAY_ONECLICK")
  /// PENDING | AUTHORIZED | CAPTURED | FAILED | REFUNDED
  paymentStatus     String  @default("PENDING")
  paymentGatewayRef String?

  // Simulated live driver position for this trip (server-side movement sim)
  liveLat Decimal?
  liveLng Decimal?

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  arrivedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Cancellation penalty (point 3, "tarifas/penalidades de cancelación"):
  // set when a trip is cancelled after a driver has already accepted it.
  /// PASSENGER | DRIVER
  cancelledBy        String?
  cancellationFeeClp Int     @default(0)

  rating   Rating?
  messages TripMessage[]
}

// Chat en vivo pasajero<->conductor, acotado a un viaje. Sin edición ni
// borrado — es un registro simple de mensajes de texto, entregados en
// tiempo real por socket (evento "trip:message" en el room `trip_${tripId}`)
// y persistidos acá para que quien entra tarde a la pantalla vea el
// historial completo del viaje.
model TripMessage {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  senderId String
  /// PASSENGER | DRIVER
  senderRole String
  text       String

  createdAt DateTime @default(now())
}

model Rating {
  id         String @id @default(uuid())
  tripId     String @unique
  trip       Trip   @relation(fields: [tripId], references: [id])
  fromUserId String
  fromUser   User   @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User   @relation("RatingsReceived", fields: [toUserId], references: [id])
  score      Int
  // JSON-encoded string[] (see header note)
  feedbackTagsJson String   @default("[]")
  tipClp           Int      @default(0)
  createdAt        DateTime @default(now())
}

model Payout {
  id         String   @id @default(uuid())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id])
  amountClp  Int
  bankTarget String
  tefRefCode String
  status     String   @default("PROCESSED")
  executedAt DateTime @default(now())
}

// ---- Business/commission model (point 3: Administrador / Dueño de la Plataforma) ----

// Single-row platform-wide settings, editable from the admin panel. Read via
// src/lib/platformConfig.ts, which lazily creates the default row on first
// read so no manual setup step is required.
model PlatformConfig {
  id String @id @default(uuid())

  // Commission taken by the platform on each completed trip, constrained to
  // 15-30% (i.e. driver net constrained to 70-85%) — see
  // src/lib/fare.ts splitFare() and DRIVER_NET_PCT_MIN/MAX.
  commissionPct Decimal @default(15.0)

  // Cancellation penalties (CLP), charged to whichever party is responsible
  // once a driver has already accepted the trip.
  cancellationFeePassengerClp Int @default(2000)
  cancellationFeeDriverClp    Int @default(3000)

  // Weekly goal bonus: a driver who completes >= this many trips within a
  // rolling week earns this bonus once per week (see DriverWeeklyBonus).
  weeklyBonusTripThreshold Int @default(20)
  weeklyBonusAmountClp     Int @default(15000)

  // VIP/priority driver subscription monthly fee.
  vipMonthlyFeeClp Int @default(12000)

  updatedAt DateTime @updatedAt
}

// One record per driver per rolling week in which they hit the weekly trip
// goal — granted automatically in src/routes/driver.ts when a trip completes.
model DriverWeeklyBonus {
  id             String   @id @default(uuid())
  driverId       String
  driver         Driver   @relation(fields: [driverId], references: [id])
  weekStart      DateTime
  tripsCompleted Int
  bonusClp       Int
  createdAt      DateTime @default(now())

  @@unique([driverId, weekStart])
}

// In-app advertising / promo banner slots, admin-managed, rendered by the
// pasajero and/or conductor frontend apps.
model AdCampaign {
  id       String  @id @default(uuid())
  title    String
  bodyText String
  imageUrl String?
  /// PASAJERO | CONDUCTOR | AMBOS
  targetAudience String  @default("AMBOS")
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
